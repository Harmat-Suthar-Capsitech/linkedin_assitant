# ============================================================
# Streamlit Community Cloud Secrets Template
# Copy and paste these into your Streamlit Cloud App Settings -> Secrets
# ============================================================

# --- Qdrant Cloud (Vector Database) ---
# Format: https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL = "https://your-qdrant-cluster.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your_qdrant_api_key_here"

# --- Redis Cloud / Upstash (Session & Conversation Persistence) ---
# Either use REDIS_URL directly (recommended for Upstash / Redis Cloud):
REDIS_URL = "rediss://default:your_password@your-endpoint.upstash.io:6379"

# Or configure individual host parameters:
# REDIS_HOST = "your-redis-host.upstash.io"
# REDIS_PORT = 6379
# REDIS_PASSWORD = "your_redis_password"
# REDIS_SSL = "true"

# --- Ollama Cloud / Remote LLM ---
# The URL of your remote Ollama endpoint (e.g. ngrok tunnel, RunPod, Modal, or VPS)
OLLAMA_BASE_URL = "http://your-remote-ollama-url:11434"
LLM_MODEL = "bjoernb/gemma4-31b-fast:latest"
EMBEDDING_MODEL = "embeddinggemma:300m"

# --- Exa.ai Job Search API ---
EXA_API_KEY = "your_exa_api_key_here"

# --- Hugging Face (for Serverless Reranker API) ---
HF_TOKEN = "your_hf_token_here"
RERANKER_MODEL = "Qwen/Qwen3-Reranker-0.6B"

# --- Email Notifications (Optional) ---
APP_SMTP_USER = "jobassistant1.1@gmail.com"
APP_SMTP_PASSWORD = "your_gmail_app_password"

# --- Telegram Bot (Optional) ---
BOT_TOKEN = "your_telegram_bot_token"
